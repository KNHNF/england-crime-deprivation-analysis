# Copy this file to .env and fill in your values. .env is gitignored.

# MongoDB connection. Local default, or an Atlas URI if the team uses a shared cluster.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=crime_deprivation

# Where the extracted police.uk CSV tree lives (relative to repo root)
POLICE_DATA_DIR=data/Crime Data LSOA (june 2023 - may 2026)
IMD_FILE=data/File_7_IoD2025_All_Ranks_Scores_Deciles_Population_Denominators.csv
PROCESSED_DIR=data/processed/lsoa_crime_deprivation
FIGURES_DIR=figures
MONGO_COLLECTION=lsoa_crime_deprivation
